@page "/personaggi/{Id:long}"
@inject UiState Ui
@inject NavigationManager Nav
@inject DeviceActions Device

@if (_loading)
{
    <Loading />
}
else if (_c == null)
{
    <Empty Icon="🧙">Personaggio non trovato.</Empty>
}
else
{
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:12px">
        <div @onclick="ChangePortrait" style="position:relative">
            <Avatar Url="@_c.PortraitPath" Name="@_c.Name" Large="true" />
            @if (CanEdit) { <span class="badge" style="position:absolute; bottom:-4px; right:-4px">📷</span> }
        </div>
        <div style="flex:1; min-width:0">
            <h1 style="margin:0">@_c.Name</h1>
            <div class="muted">@_c.Race @_c.Class · liv. @_c.Level</div>
            <div class="small muted">Competenza @CharacterRules.FormatMod(_c.ProficiencyBonus) · CA @_c.ArmorClass · Vel. @_c.Speed m</div>
            @if (_c.IsNpc) { <span class="badge npc">NPC</span> }
        </div>
    </div>

    <!-- Punti ferita: modificabili al volo durante la sessione -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center">
            <h3 style="margin:0">❤️ Punti ferita</h3>
            <span class="small muted">@(_c.HpTemp > 0 ? $"+{_c.HpTemp} temporanei" : "")</span>
        </div>
        <div style="margin:10px 0"><HpBar Current="_c.HpCurrent" Max="_c.HpMax" /></div>
        <div style="display:flex; align-items:center; justify-content:space-between; gap:8px">
            <div class="stepper">
                <button disabled="@(!CanEdit)" @onclick="() => ChangeHp(-1)">−</button>
                <div class="v">@_c.HpCurrent<span class="muted small">/@_c.HpMax</span></div>
                <button disabled="@(!CanEdit)" @onclick="() => ChangeHp(1)">+</button>
            </div>
            @if (CanEdit)
            {
                <div style="display:flex; gap:6px">
                    <button class="btn small ghost" @onclick="() => ChangeHp(-5)">−5</button>
                    <button class="btn small ghost" @onclick="() => ChangeHp(5)">+5</button>
                </div>
            }
        </div>
    </div>

    <div class="segments">
        <button class="@(_tab == 0 ? "on" : "")" @onclick="() => _tab = 0">Generale</button>
        <button class="@(_tab == 1 ? "on" : "")" @onclick="() => _tab = 1">📊 Caratteristiche</button>
        <button class="@(_tab == 2 ? "on" : "")" @onclick="OpenInventory">🎒 Inventario</button>
    </div>

    @if (_tab == 0)
    {
        <div class="card">
            <label>Nome</label>
            <input type="text" @bind="_c.Name" disabled="@(!CanEdit)" />

            <div class="grid2">
                <div>
                    <label>Razza</label>
                    <input type="text" list="races" @bind="_c.Race" disabled="@(!CanEdit)" />
                </div>
                <div>
                    <label>Livello</label>
                    <input type="number" min="1" max="20" @bind="_c.Level" disabled="@(!CanEdit)" />
                </div>
            </div>
            <datalist id="races">@foreach (var r in _races) { <option value="@r"></option> }</datalist>

            <label>Classe (più classi separate da " / ")</label>
            <input type="text" list="classes" @bind="_c.Class" disabled="@(!CanEdit)" />
            <datalist id="classes">@foreach (var r in _classes) { <option value="@r"></option> }</datalist>

            @if (AppSession.IsMaster)
            {
                <label>Proprietario (nome utente del giocatore)</label>
                <input type="text" @bind="_c.Owner" @bind:after="ClearOwnerId" autocapitalize="none" />
                <label class="check"><input type="checkbox" @bind="_c.IsNpc" /> È un NPC</label>
            }

            <label>Note</label>
            <textarea @bind="_c.Notes" disabled="@(!CanEdit)"></textarea>

            <label>Linguaggi</label>
            <input type="text" @bind="_c.Languages" disabled="@(!CanEdit)" />
            <label>Altre competenze</label>
            <textarea style="min-height:70px" @bind="_c.OtherProficiencies" disabled="@(!CanEdit)"></textarea>

            <h3>💰 Monete</h3>
            <div class="grid3">
                <div><label>MP (platino)</label><input type="number" min="0" @bind="_c.CoinsPp" disabled="@(!CanEdit)" /></div>
                <div><label>MO (oro)</label><input type="number" min="0" @bind="_c.CoinsPo" disabled="@(!CanEdit)" /></div>
                <div><label>ME (electrum)</label><input type="number" min="0" @bind="_c.CoinsPe" disabled="@(!CanEdit)" /></div>
                <div><label>MA (argento)</label><input type="number" min="0" @bind="_c.CoinsPa" disabled="@(!CanEdit)" /></div>
                <div><label>MR (rame)</label><input type="number" min="0" @bind="_c.CoinsPr" disabled="@(!CanEdit)" /></div>
            </div>

            @if (!string.IsNullOrEmpty(_c.SheetPath))
            {
                <button class="btn ghost block mt" @onclick="() => Device.OpenUrlAsync(_c.SheetPath)">📄 Apri file scheda</button>
            }
        </div>
    }
    else if (_tab == 1)
    {
        <div class="card">
            <div class="abilities">
                @foreach (var a in CharacterRules.Abilities)
                {
                    var score = CharacterRules.GetScore(_c, a.Key);
                    <div class="ability">
                        <div class="ab">@a.Short</div>
                        <div class="mod">@CharacterRules.FormatMod(Character.Modifier(score))</div>
                        <input type="number" min="1" max="30" value="@score" disabled="@(!CanEdit)"
                               @onchange="e => SetScore(a.Key, e.Value)" />
                    </div>
                }
            </div>

            <div class="grid3 mt">
                <div><label>Classe Armatura</label><input type="number" @bind="_c.ArmorClass" disabled="@(!CanEdit)" /></div>
                <div><label>Velocità (m)</label><input type="number" @bind="_c.Speed" disabled="@(!CanEdit)" /></div>
                <div><label>Dado vita</label><input type="text" @bind="_c.HitDice" disabled="@(!CanEdit)" /></div>
                <div><label>PF massimi</label><input type="number" @bind="_c.HpMax" disabled="@(!CanEdit)" /></div>
                <div><label>PF attuali</label><input type="number" @bind="_c.HpCurrent" disabled="@(!CanEdit)" /></div>
                <div><label>PF temporanei</label><input type="number" @bind="_c.HpTemp" disabled="@(!CanEdit)" /></div>
            </div>
            <p class="small muted mt">Percezione passiva: <b>@CharacterRules.PassivePerception(_c)</b></p>
        </div>

        <div class="card">
            <h3 style="margin-top:0">Tiri salvezza</h3>
            @foreach (var a in CharacterRules.Abilities)
            {
                var prof = CharacterRules.ParseList(_c.ProficientSaves).Contains(a.Short);
                <div class="statline @(prof ? "prof" : "")">
                    <label class="check" style="flex:1">
                        <input type="checkbox" checked="@prof" disabled="@(!CanEdit)" @onchange="e => ToggleSave(a.Short, e.Value)" />
                        <span class="lbl">@a.Full</span>
                    </label>
                    <span class="val">@CharacterRules.FormatMod(CharacterRules.SaveBonus(_c, a.Key, a.Short))</span>
                </div>
            }
        </div>

        <div class="card">
            <h3 style="margin-top:0">Abilità</h3>
            @foreach (var s in CharacterRules.Skills)
            {
                var prof = CharacterRules.ParseList(_c.ProficientSkills).Contains(s.Name);
                var ab = CharacterRules.Abilities.First(x => x.Key == s.AbilityKey).Short;
                <div class="statline @(prof ? "prof" : "")">
                    <label class="check" style="flex:1">
                        <input type="checkbox" checked="@prof" disabled="@(!CanEdit)" @onchange="e => ToggleSkill(s.Name, e.Value)" />
                        <span class="lbl">@s.Name <span class="muted small">(@ab)</span></span>
                    </label>
                    <span class="val">@CharacterRules.FormatMod(CharacterRules.SkillBonus(_c, s.Name, s.AbilityKey))</span>
                </div>
            }
        </div>
    }
    else
    {
        @if (_invLoading)
        {
            <Loading />
        }
        else
        {
            <div class="card">
                <h3 style="margin-top:0">🎒 Equipaggiamento</h3>
                @if (_equip.Count == 0) { <p class="muted small">Nessun oggetto assegnato.</p> }
                @foreach (var e in _equip)
                {
                    <a class="statline" href="@($"equipaggiamento/{e.Item.Id}")" style="color:inherit; text-decoration:none">
                        <span>@e.Item.Name <span class="muted small">@e.Item.Type</span></span>
                        <span class="val">@(e.Qty > 1 ? $"×{e.Qty}" : "")</span>
                    </a>
                }
            </div>
            <div class="card">
                <h3 style="margin-top:0">✨ Incantesimi</h3>
                @if (_spells.Count == 0) { <p class="muted small">Nessun incantesimo assegnato.</p> }
                @foreach (var s in _spells)
                {
                    <a class="statline" href="@($"incantesimi/{s.Id}")" style="color:inherit; text-decoration:none">
                        <span>@s.Name</span>
                        <span class="val small">@(s.Level == 0 ? "Trucchetto" : $"Liv. {s.Level}")</span>
                    </a>
                }
            </div>
            @if (AppSession.IsMaster)
            {
                <p class="small muted">Per assegnare oggetti o incantesimi apri la voce da “Altro → Equipaggiamento / Incantesimi”.</p>
            }
        }
    }

    @if (CanEdit)
    {
        <div class="btn-row">
            <button class="btn" disabled="@_busy" @onclick="Save">💾 Salva</button>
        </div>
        <div class="btn-row">
            <button class="btn danger small" disabled="@_busy" @onclick="Delete">🗑 Elimina personaggio</button>
        </div>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private Character? _c;
    private bool _loading = true, _busy, _invLoading;
    private int _tab;
    private List<string> _races = CharacterRules.SrdRaces.ToList();
    private List<string> _classes = CharacterRules.SrdClasses.ToList();
    private List<(DnDManager.Data.Remote.RestEquipment Item, int Qty)> _equip = new();
    private List<DnDManager.Data.Remote.RestSpell> _spells = new();
    private bool _inventoryLoaded;

    private bool CanEdit => _c != null && (AppSession.IsMaster || _c.OwnerId == AppSession.UserId ||
        string.Equals(_c.Owner, AppSession.UserName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        Ui.SetTitle("🧙 Scheda");
        _loading = true;
        try
        {
            var all = await RemoteCharacters.GetAllAsync();
            _c = all.FirstOrDefault(x => x.Id == Id);
            if (_c != null) Ui.SetTitle("🧙 " + _c.Name);
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { _loading = false; }

        _ = LoadGameDataAsync();
    }

    private async Task LoadGameDataAsync()
    {
        try
        {
            var r = await RemoteGameData.GetCustomRacesAsync();
            var c = await RemoteGameData.GetCustomClassesAsync();
            _races = CharacterRules.SrdRaces.Concat(r).Distinct().OrderBy(x => x).ToList();
            _classes = CharacterRules.SrdClasses.Concat(c).Distinct().OrderBy(x => x).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* restano le voci SRD */ }
    }

    private void ClearOwnerId()
    {
        // Il Master ha cambiato il nome del proprietario: l'id verrà ricalcolato dal nome al salvataggio
        if (_c != null) _c.OwnerId = null;
    }

    private void SetScore(string key, object? value)
    {
        if (_c == null) return;
        if (int.TryParse(value?.ToString(), out var v)) CharacterRules.SetScore(_c, key, v);
    }

    private void ToggleSave(string shortName, object? value)
    {
        if (_c == null) return;
        var set = CharacterRules.ParseList(_c.ProficientSaves);
        if (value is true) set.Add(shortName); else set.Remove(shortName);
        // conserva l'ordine canonico usato dalla versione PC
        _c.ProficientSaves = CharacterRules.ToList(CharacterRules.Abilities.Select(a => a.Short).Where(set.Contains));
    }

    private void ToggleSkill(string name, object? value)
    {
        if (_c == null) return;
        var set = CharacterRules.ParseList(_c.ProficientSkills);
        if (value is true) set.Add(name); else set.Remove(name);
        _c.ProficientSkills = CharacterRules.ToList(CharacterRules.Skills.Select(s => s.Name).Where(set.Contains));
    }

    private async Task ChangeHp(int delta)
    {
        if (_c == null || !CanEdit) return;
        var max = _c.HpMax > 0 ? _c.HpMax : int.MaxValue;
        _c.HpCurrent = Math.Clamp(_c.HpCurrent + delta, 0, max);
        try { await RemoteCharacters.SaveAsync(_c); }
        catch (Exception ex) { Ui.Error(ex); }
    }

    private async Task OpenInventory()
    {
        _tab = 2;
        if (_inventoryLoaded || _c == null) return;
        _invLoading = true;
        try
        {
            var qty = await RemoteEquipment.GetAssignedQuantitiesAsync(_c.Id);
            if (qty.Count > 0)
            {
                var items = await SupabaseRest.GetAsync<DnDManager.Data.Remote.RestEquipment>(
                    $"equipment?id=in.({string.Join(",", qty.Keys)})&select=*&order=name");
                _equip = items.Select(i => (i, qty.TryGetValue(i.Id, out var q) ? q : 1)).ToList();
            }

            var spellIds = await RemoteSpells.GetAssignedSpellIdsAsync(_c.Id);
            if (spellIds.Count > 0)
                _spells = await SupabaseRest.GetAsync<DnDManager.Data.Remote.RestSpell>(
                    $"spells?id=in.({string.Join(",", spellIds)})&select=*&order=level,name");
            _inventoryLoaded = true;
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { _invLoading = false; }
    }

    private async Task ChangePortrait()
    {
        if (_c == null || !CanEdit) return;
        try
        {
            var file = await Device.PickImageAsync();
            if (file == null) return;
            _busy = true;
            _c.PortraitPath = await SupabaseStorage.UploadBytesAsync("portraits", file.FileName, file.Bytes);
            await RemoteCharacters.SaveAsync(_c);
            Ui.ShowToast("Ritratto aggiornato ✓");
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { _busy = false; }
    }

    private async Task Save()
    {
        if (_c == null) return;
        if (string.IsNullOrWhiteSpace(_c.Name)) { Ui.ShowToast("Il nome non può essere vuoto.", true); return; }
        _busy = true;
        try
        {
            _c.Level = Math.Clamp(_c.Level, 1, 20);
            if (!AppSession.IsMaster) _c.IsNpc = false;
            await RemoteCharacters.SaveAsync(_c);
            Ui.SetTitle("🧙 " + _c.Name);
            Ui.ShowToast("Personaggio salvato ✓");
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (_c == null) return;
        if (!await Device.ConfirmAsync("Elimina", $"Eliminare definitivamente \"{_c.Name}\"?", "Elimina")) return;
        _busy = true;
        try
        {
            await RemoteCharacters.DeleteAsync(_c.Id);
            Nav.NavigateTo("personaggi");
        }
        catch (Exception ex) { Ui.Error(ex); }
        finally { _busy = false; }
    }
}
